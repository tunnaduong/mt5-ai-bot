# ====================== MetaTrader 5 (FxPro) ======================
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=FxPro-MT5 Demo
# MT5_PATH=C:\Program Files\FxPro - MetaTrader 5\terminal64.exe
MT5_MAGIC=20261120
MT5_DEVIATION=20

# ====================== AI endpoint ======================
# openai = OpenAI-compatible /v1/chat/completions ; custom = POST {system, snapshot} -> JSON
AI_API_STYLE=openai
AI_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SEC=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.2
AI_JSON_MODE=true
AI_REASONING_LANGUAGE=Vietnamese
AI_FAILURE_ALERT_THRESHOLD=3

# ====================== Telegram ======================
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_ADMIN_CHAT_ID=123456789

# ====================== Trading loop ======================
SYMBOLS=EURUSD,GOLD
TIMEFRAME=M15
CONTEXT_TIMEFRAMES=H1,H4
LOOP_INTERVAL_SEC=10
MONITOR_INTERVAL_SEC=5
# LUÔN để true khi mới chạy. false = gửi lệnh thật lên MT5 (kể cả tài khoản demo)
DRY_RUN=true
# Bắt buộc =true mới cho phép LIVE trên tài khoản REAL (lớp bảo vệ thứ 2)
ALLOW_REAL_ACCOUNT=false
NOTIFY_MIN_CONFIDENCE=0.6
DAILY_SUMMARY_HOUR_UTC=21

# ====================== Risk ======================
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
DAILY_MAX_LOSS_PCT=3
DAILY_LOSS_CLOSE_ALL=false
# Spread tối đa (points) mặc định + override theo symbol
MAX_SPREAD_POINTS=30
MAX_SPREAD_OVERRIDES=GOLD:50,BITCOIN:5000,GOLDgr:30
MAX_SPREAD_ATR_RATIO=0.25
MIN_CONFIDENCE=0.65
MIN_RR=1.2
MAX_SL_ATR_MULT=5
MIN_SL_ATR_MULT=0.3
# >0: nếu AI quên SL thì dùng N x ATR. 0 = chặn lệnh thiếu SL
SL_FALLBACK_ATR_MULT=0
MAX_TICK_AGE_SEC=180
MAX_MARGIN_USAGE_PCT=30
MAX_LOT_CAP=0
# Tài khoản nhỏ: nếu lot theo RISK_PER_TRADE_PCT < lot tối thiểu, cho phép dùng lot tối thiểu
# khi rủi ro thực của nó <= N% equity (tối đa 10). 0 = tắt (mặc định, an toàn nhất).
# Gợi ý cho ~$100: xem mục "Tài khoản nhỏ" trong README.
MIN_LOT_MAX_RISK_PCT=0

# ====================== Storage ======================
DB_PATH=data/bot.db
LOG_DIR=logs
LOG_LEVEL=INFO
